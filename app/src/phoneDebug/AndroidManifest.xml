<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-feature android:name="android.software.leanback" tools:node="remove" />
    <application>
        <!-- Replace the TV entry points only in this separate, signed Debug variant. -->
        <activity android:name=".MainActivity" android:exported="true" android:launchMode="singleTask" tools:node="replace">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <receiver android:name=".setup.MosqueDeviceAdmin" tools:node="remove" />
        <activity android:name=".setup.ProvisioningActivity" tools:node="remove" />
    </application>
</manifest>
