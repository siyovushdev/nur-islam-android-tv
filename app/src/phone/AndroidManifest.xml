<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="MissingLeanbackLauncher">
    <!-- Lint visits this raw removal marker as a TV declaration. The merged APK
         has no leanback feature/launcher; PhoneActivityTest verifies its entry points. -->
    <uses-feature android:name="android.software.leanback" tools:node="remove" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <queries>
        <intent><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.HOME" /></intent>
    </queries>
    <application tools:remove="android:banner">
        <!-- Both phone variants have ordinary launcher access and no device policies. -->
        <activity android:name=".MainActivity" android:exported="true" android:launchMode="singleTask" tools:node="replace">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <receiver android:name=".setup.MosqueDeviceAdmin" tools:node="remove" />
        <activity android:name=".setup.ProvisioningActivity" tools:node="remove" />
    </application>
</manifest>
